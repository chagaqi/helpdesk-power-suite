# ---- Required in production -------------------------------------------------
NODE_ENV=production
PORT=8787
PUBLIC_BASE_URL=https://api.helpdeskpowersuite.com
# >= 32 chars. Derives every per-install signing secret. Rotating it invalidates all installs.
HPS_MASTER_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Optional separate key for signed download links (defaults to a derivation of the master secret)
# HPS_LINK_SECRET=

# ---- Storage (pick one; default is in-memory) --------------------------------
# REDIS_URL=rediss://default:password@redis.example.com:6380/0
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
# REDIS_PREFIX=hps:

# ---- Billing ----------------------------------------------------------------
# Webhook signing secrets (endpoints: /v1/webhooks/polar, /v1/webhooks/stripe, /v1/webhooks/marketplace)
# POLAR_WEBHOOK_SECRET=
# STRIPE_WEBHOOK_SECRET=whsec_...
# MARKETPLACE_WEBHOOK_SECRET=
# Self-serve checkout from the app (POST /v1/billing/checkout)
# BILLING_PROVIDER=polar            # or stripe
# POLAR_ACCESS_TOKEN=
# POLAR_PRODUCT_ID=
# POLAR_API_BASE=https://sandbox-api.polar.sh
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRICE_ID=price_...
# CHECKOUT_SUCCESS_URL=https://helpdeskpowersuite.com/thanks
# UPGRADE_URL=https://helpdeskpowersuite.com/pricing

# ---- Security / networking ----------------------------------------------------
# Trust X-Forwarded-For (only behind a proxy you control)
TRUST_PROXY=1
# CORS_ORIGINS=https://acme.zendesk.com,https://acme.freshdesk.com
# Zendesk app public key (PEM, "\n" escaped) to accept signed-URL proofs when re-registering a tenant
# ZENDESK_APP_PUBLIC_KEY=
DOWNLOAD_TTL_SECONDS=900
MAX_EXPORT_BODY_MB=25

# ---- Playground ---------------------------------------------------------------
PLAYGROUND_ENABLED=1
PLAYGROUND_RATE_LIMIT=30
PLAYGROUND_RATE_WINDOW_SECONDS=3600
PLAYGROUND_MAX_RECORDS=5000

# ---- Companions ---------------------------------------------------------------
# GORGIAS_WIDGET_SECRET=at-least-16-characters
# GORGIAS_ACCOUNTS=acme=ops@acme.com:GORGIAS_API_KEY
# INTERCOM_CLIENT_SECRET=
# INTERCOM_ACCESS_TOKENS=workspace_id=access_token
